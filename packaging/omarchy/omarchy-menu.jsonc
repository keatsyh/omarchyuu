{
  // Add omarchyuu to the Omarchy menu (Super + Space → Install → Service).
  //
  // Copy this file to ~/.config/omarchy/extensions/omarchy-menu.jsonc, or merge
  // the single entry below into an existing extension. The shell watches the
  // file, so no restart is needed.
  //
  // The entry follows the Omarchy convention for install rows: `disabled` (not
  // `when`) so an installed omarchyuu reads as installed rather than vanishing
  // from the catalog. PATH detection covers both package and manual installs.
  "install.service.openuuyc": {
    "icon": "",
    "label": "omarchyuu",
    "description": "Third-party UU Remote client with Wayland host support",
    "disabled": "command -v omarchyuu >/dev/null",
    "action": "omarchy-launch-floating-terminal-with-presentation omarchy-pkg-aur-add omarchyuu-bin",
  },
}
